{
  "dependencies": {
    "@usebruno/cli": "^3.2.0",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.11.1"
  },
  "name": "sis",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test \"tests-unit/**/*.test.cjs\"",
    "lint:bru": "node scripts/lint-bruno.cjs",
    "lint:bru:json": "node scripts/lint-bruno.cjs --json",
    "prepare": "npx simple-git-hooks",
    "scenarios:run": "node scripts/run-scenarios.cjs",
    "test:coverage": "node --test --experimental-test-coverage \"tests-unit/**/*.test.cjs\""
  },
  "overrides": {
    "fast-xml-parser": "^5.5.6",
    "axios": "^1.18.0",
    "form-data": "^4.0.6",
    "uuid": "^11.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:bru"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Root workspace for Bruno certification; includes custom Bruno file linter."
}
