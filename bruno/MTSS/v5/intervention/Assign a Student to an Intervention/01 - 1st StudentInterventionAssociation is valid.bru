meta {
  name: 01 - 1st StudentInterventionAssociation is valid
  type: http
  seq: 1
}

get {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations?studentUniqueId=[ENTER FIRST STUDENT UNIQUE ID]&educationOrganizationId={{firstInterventionEducationOrganizationId}}&interventionIdentificationCode={{firstInterventionIdentificationCode}}
  body: none
  auth: inherit
}

params:query {
  studentUniqueId: [ENTER FIRST STUDENT UNIQUE ID]
  educationOrganizationId: {{firstInterventionEducationOrganizationId}}
  interventionIdentificationCode: {{firstInterventionIdentificationCode}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].studentReference.studentUniqueId: isString
  res.body[0].studentReference.studentUniqueId: isNotEmpty
  res.body[0].interventionReference.educationOrganizationId: isNumber
  res.body[0].interventionReference.interventionIdentificationCode: isString
  res.body[0].interventionReference.interventionIdentificationCode: isNotEmpty
  res.body[0].dosage: isNumber
  res.body[0].dosage: gt 0
  res.body[0].diagnosticStatement: isString
  res.body[0].diagnosticStatement: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const source = dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid');
  
  validateDependency(bru, 'firstInterventionEducationOrganizationId', source);
  validateDependency(bru, 'firstInterventionIdentificationCode', source);
}

script:post-response {
  const { pickSingle, setVars, wipeVars, cohortKeyOf } = require('./utils');
  const { logScenario, logSpecStudentInterventionAssociation } = require('./logging');
  const entityName = 'StudentInterventionAssociation';
  const scenarioName = this.req.name;
  const single = pickSingle(res.getBody());
  
  if (!single) {
    wipeVars(bru, [
      'firstStudentInterventionAssociationUniqueId',
      'firstStudentInterventionAssociationStudentUniqueId',
      'firstStudentInterventionAssociationDosage',
      'firstStudentInterventionAssociationCohortKey',
      'firstStudentInterventionAssociationDiagnosticStatement'
    ], entityName, true);
  }
  
  setVars(bru, {
    firstStudentInterventionAssociationUniqueId: single.id,
    firstStudentInterventionAssociationStudentUniqueId: single.studentReference.studentUniqueId,
    firstStudentInterventionAssociationDosage: single.dosage,
    // Baseline for PATH 2 step 04, which must show the cohortReference was added or changed.
    firstStudentInterventionAssociationCohortKey: cohortKeyOf(single.cohortReference),
    // Baseline for "Recovery and Resubmission" step 11 (restored with the latest value).
    firstStudentInterventionAssociationDiagnosticStatement: single.diagnosticStatement
  }, entityName);
  
  logScenario(entityName, scenarioName, single, logSpecStudentInterventionAssociation);
}

settings {
  encodeUrl: true
  timeout: 0
}
