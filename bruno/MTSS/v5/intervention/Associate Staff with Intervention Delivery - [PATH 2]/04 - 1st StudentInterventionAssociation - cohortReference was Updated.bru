meta {
  name: 04 - 1st StudentInterventionAssociation - cohortReference was Updated
  type: http
  seq: 4
}

get {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations/{{firstStudentInterventionAssociationUniqueId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.id: isString
  res.body.id: isNotEmpty
  res.body.studentReference.studentUniqueId: isString
  res.body.studentReference.studentUniqueId: isNotEmpty
  res.body.interventionReference: isDefined
  res.body.interventionReference.educationOrganizationId: isNumber
  res.body.interventionReference.educationOrganizationId: neq 0
  res.body.interventionReference.interventionIdentificationCode: isString
  res.body.interventionReference.interventionIdentificationCode: isNotEmpty
  res.body.dosage: isNumber
  res.body.cohortReference: isDefined
  res.body.cohortReference.cohortIdentifier: isString
  res.body.cohortReference.cohortIdentifier: isNotEmpty
  res.body.diagnosticStatement: isString
  res.body.diagnosticStatement: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const cohort = dependencyName('Associate Staff with Intervention Delivery - [PATH 2]', '01 - 1st Cohort is valid');

  const assign = dependencyName('Assign a Student to an Intervention', '01 - 1st StudentInterventionAssociation is valid');

  validateDependency(bru, 'firstStudentInterventionAssociationUniqueId', assign);
  validateDependency(bru, 'firstStudentInterventionAssociationCohortKey', assign);
  validateDependency(bru, 'firstCohortIdentifier', cohort);
  validateDependency(bru, 'firstCohortEducationOrganizationId', cohort);
}

script:post-response {
  const { getVar, setVars, expectChanged, cohortKeyOf, throwNotFoundOrSpecificError } = require('./utils');
  const { logScenario, logSpecStudentInterventionAssociation } = require('./logging');
  const entityName = 'StudentInterventionAssociation';
  const scenarioName = this.req.name;

  if (res.status !== 200 || !res.body) {
    throwNotFoundOrSpecificError(entityName);
  }

  const current = res.getBody();
  const cohortRef = current.cohortReference || {};

  test('cohortReference points to the 1st Cohort', () => {
    expect(cohortRef.cohortIdentifier).to.equal(getVar(bru, 'firstCohortIdentifier'));
    expect(String(cohortRef.educationOrganizationId)).to.equal(String(getVar(bru, 'firstCohortEducationOrganizationId')));
  });
  // The baseline from "Assign a Student to an Intervention" must differ: an association that
  // already referenced the Cohort before this scenario was not updated here.
  expectChanged(getVar(bru, 'firstStudentInterventionAssociationCohortKey'), cohortKeyOf(current.cohortReference), 'cohortReference');

  // This update re-sends the whole association: it is now the latest source for the
  // diagnosticStatement "Recovery and Resubmission" step 11 expects after synchronization.
  setVars(bru, {
    firstStudentInterventionAssociationDiagnosticStatement: current.diagnosticStatement
  }, entityName);

  logScenario(entityName, scenarioName, current, logSpecStudentInterventionAssociation, [
    'studentUniqueId',
    'cohortIdentifier'
  ]);
}

settings {
  encodeUrl: true
  timeout: 0
}
