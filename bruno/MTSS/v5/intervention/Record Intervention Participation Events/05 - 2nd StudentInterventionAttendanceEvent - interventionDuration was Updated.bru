meta {
  name: 05 - 2nd StudentInterventionAttendanceEvent - interventionDuration was Updated
  type: http
  seq: 5
}

get {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents/{{secondStudentInterventionAttendanceEventUniqueId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.id: isString
  res.body.id: isNotEmpty
  res.body.studentReference.studentUniqueId: isString
  res.body.studentReference.studentUniqueId: isNotEmpty
  res.body.interventionReference.educationOrganizationId: isNumber
  res.body.interventionReference.educationOrganizationId: neq 0
  res.body.interventionReference.interventionIdentificationCode: isString
  res.body.interventionReference.interventionIdentificationCode: isNotEmpty
  res.body.eventDate: isString
  res.body.eventDate: isNotEmpty
  res.body.attendanceEventCategoryDescriptor: isString
  res.body.attendanceEventCategoryDescriptor: isNotEmpty
  res.body.interventionDuration: isNumber
  res.body.interventionDuration: gte 0
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const source = dependencyName('Record Intervention Participation Events', '02 - 2nd StudentInterventionAttendanceEvent is valid');

  validateDependency(bru, 'secondStudentInterventionAttendanceEventUniqueId', source);
  validateDependency(bru, 'secondStudentInterventionAttendanceEventInterventionDuration', source);
}

script:post-response {
  const { getVar, setVars, expectChanged, throwNotFoundOrSpecificError } = require('./utils');
  const { logScenario, logSpecStudentInterventionAttendanceEvent } = require('./logging');
  const entityName = 'StudentInterventionAttendanceEvent';
  const scenarioName = this.req.name;

  if (res.status !== 200 || !res.body) {
    throwNotFoundOrSpecificError(entityName);
  }

  const current = res.getBody();

  expectChanged(getVar(bru, 'secondStudentInterventionAttendanceEventInterventionDuration'), current.interventionDuration, 'interventionDuration');

  setVars(bru, {
    secondStudentInterventionAttendanceEventInterventionDuration: current.interventionDuration
  }, entityName);

  logScenario(entityName, scenarioName, current, logSpecStudentInterventionAttendanceEvent, [
    'interventionDuration'
  ]);
}

settings {
  encodeUrl: true
  timeout: 0
}
