meta {
  name: 08 - [optional] - 6th StudentInterventionAttendanceEvent is valid
  type: http
  seq: 8
}

get {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents?studentUniqueId={{firstStudentInterventionAssociationStudentUniqueId}}&educationOrganizationId={{firstInterventionEducationOrganizationId}}&interventionIdentificationCode={{firstInterventionIdentificationCode}}&eventDate=[ENTER SIXTH EVENT DATE YYYY-MM-DD]&attendanceEventCategoryDescriptor={{sixthStudentInterventionAttendanceEventCategoryEncoded}}&attendanceEventCategoryDescriptor_KEEP_IT_AT_THE_END=[ENTER SIXTH ATTENDANCE EVENT CATEGORY DESCRIPTOR]
  body: none
  auth: inherit
}

params:query {
  studentUniqueId: {{firstStudentInterventionAssociationStudentUniqueId}}
  educationOrganizationId: {{firstInterventionEducationOrganizationId}}
  interventionIdentificationCode: {{firstInterventionIdentificationCode}}
  eventDate: [ENTER SIXTH EVENT DATE YYYY-MM-DD]
  attendanceEventCategoryDescriptor: {{sixthStudentInterventionAttendanceEventCategoryEncoded}}
  attendanceEventCategoryDescriptor_KEEP_IT_AT_THE_END: [ENTER SIXTH ATTENDANCE EVENT CATEGORY DESCRIPTOR]
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].studentReference.studentUniqueId: isString
  res.body[0].studentReference.studentUniqueId: isNotEmpty
  res.body[0].interventionReference.educationOrganizationId: isNumber
  res.body[0].interventionReference.educationOrganizationId: neq 0
  res.body[0].interventionReference.interventionIdentificationCode: isString
  res.body[0].interventionReference.interventionIdentificationCode: isNotEmpty
  res.body[0].eventDate: isString
  res.body[0].eventDate: isNotEmpty
  res.body[0].attendanceEventCategoryDescriptor: isString
  res.body[0].attendanceEventCategoryDescriptor: isNotEmpty
  res.body[0].interventionDuration: isNumber
  res.body[0].interventionDuration: gte 0
  res.body[0].attendanceEventReason: isString
  res.body[0].attendanceEventReason: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName, encodeDescriptorParameter, setVar } = require('./utils');
  const intervention = dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid');
  const student = dependencyName('Assign a Student to an Intervention', '01 - 1st StudentInterventionAssociation is valid');
  
  validateDependency(bru, 'firstInterventionEducationOrganizationId', intervention);
  validateDependency(bru, 'firstInterventionIdentificationCode', intervention);
  validateDependency(bru, 'firstStudentInterventionAssociationStudentUniqueId', student);
  
  setVar(bru, 'sixthStudentInterventionAttendanceEventCategoryEncoded', encodeDescriptorParameter(req.url, 'attendanceEventCategoryDescriptor_KEEP_IT_AT_THE_END'));
}

script:post-response {
  const { pickSingle, setVars, wipeVars, isEdFiDefaultDescriptor } = require('./utils');
  const { logScenario, logSpecStudentInterventionAttendanceEvent } = require('./logging');
  const entityName = 'StudentInterventionAttendanceEvent';
  const scenarioName = this.req.name;
  const single = pickSingle(res.getBody());
  
  if (!single) {
    wipeVars(bru, [
      'sixthStudentInterventionAttendanceEventUniqueId',
      'sixthStudentInterventionAttendanceEventEventDate',
      'sixthStudentInterventionAttendanceEventCategory',
      'sessionNotHeldCategory'
    ], entityName, true);
  }

  // Sessions that don't fit the default categories use a descriptor in the provider's own namespace.
  test('Session Not Held uses the provider namespace, not uri://ed-fi.org', () => {
    expect(isEdFiDefaultDescriptor(single.attendanceEventCategoryDescriptor),
      `${single.attendanceEventCategoryDescriptor} is a default Ed-Fi category; use a descriptor in your own namespace`).to.equal(false);
  });
  
  setVars(bru, {
    sixthStudentInterventionAttendanceEventUniqueId: single.id,
    sixthStudentInterventionAttendanceEventEventDate: single.eventDate,
    sixthStudentInterventionAttendanceEventCategory: single.attendanceEventCategoryDescriptor,
    sessionNotHeldCategory: single.attendanceEventCategoryDescriptor
  }, entityName);
  
  logScenario(entityName, scenarioName, single, logSpecStudentInterventionAttendanceEvent);
}

settings {
  encodeUrl: false
  timeout: 0
}
