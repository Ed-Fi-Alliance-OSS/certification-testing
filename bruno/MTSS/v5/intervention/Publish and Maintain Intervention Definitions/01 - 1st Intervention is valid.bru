meta {
  name: 01 - 1st Intervention is valid
  type: http
  seq: 1
}

get {
  url: {{resourceBaseUrl}}/ed-fi/interventions?educationOrganizationId=[ENTER FIRST EDUCATION ORGANIZATION ID]&interventionIdentificationCode=[ENTER FIRST INTERVENTION IDENTIFICATION CODE]
  body: none
  auth: inherit
}

params:query {
  educationOrganizationId: [ENTER FIRST EDUCATION ORGANIZATION ID]
  interventionIdentificationCode: [ENTER FIRST INTERVENTION IDENTIFICATION CODE]
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].interventionIdentificationCode: isString
  res.body[0].interventionIdentificationCode: isNotEmpty
  res.body[0].educationOrganizationReference: isDefined
  res.body[0].educationOrganizationReference.educationOrganizationId: isNumber
  res.body[0].educationOrganizationReference.educationOrganizationId: neq 0
  res.body[0].interventionClassDescriptor: isString
  res.body[0].interventionClassDescriptor: isNotEmpty
  res.body[0].deliveryMethodDescriptor: isString
  res.body[0].deliveryMethodDescriptor: isNotEmpty
  res.body[0].beginDate: isString
  res.body[0].beginDate: isNotEmpty
  res.body[0].namespace: isString
  res.body[0].namespace: isNotEmpty
  res.body[0].diagnoses: isArray
  res.body[0].diagnoses: isNotEmpty
  res.body[0].diagnoses[0].diagnosisDescriptor: isString
  res.body[0].diagnoses[0].diagnosisDescriptor: isNotEmpty
  res.body[0].minDosage: isNumber
  res.body[0].minDosage: gt 0
  res.body[0].maxDosage: isNumber
  res.body[0].maxDosage: gt 0
  res.body[0].meetingTimes: isArray
  res.body[0].meetingTimes: isNotEmpty
  res.body[0].meetingTimes[0].startTime: isString
  res.body[0].meetingTimes[0].startTime: isNotEmpty
  res.body[0].meetingTimes[0].endTime: isString
  res.body[0].meetingTimes[0].endTime: isNotEmpty
}

script:post-response {
  const { pickSingle, setVars, wipeVars, meetingTimesKeyOf, diagnosesKeyOf } = require('./utils');
  const { logScenario, logSpecIntervention } = require('./logging');
  const entityName = 'Intervention';
  const scenarioName = this.req.name;
  const single = pickSingle(res.getBody());
  
  if (!single) {
    wipeVars(bru, [
      'firstInterventionUniqueId',
      'firstInterventionIdentificationCode',
      'firstInterventionEducationOrganizationId',
      'firstInterventionBeginDate',
      'firstInterventionEndDate',
      'firstInterventionMaxDosage',
      'firstInterventionMinDosage',
      'firstInterventionMeetingTimesKey',
      'firstInterventionDiagnosesKey'
    ], entityName, true);
  }
  
  setVars(bru, {
    firstInterventionUniqueId: single.id,
    firstInterventionIdentificationCode: single.interventionIdentificationCode,
    firstInterventionEducationOrganizationId: single.educationOrganizationReference.educationOrganizationId,
    firstInterventionBeginDate: single.beginDate,
    firstInterventionEndDate: single.endDate,
    firstInterventionMaxDosage: single.maxDosage,
    // Baselines for "Recovery and Resubmission" step 09 (restored with the latest values).
    firstInterventionMinDosage: single.minDosage,
    firstInterventionMeetingTimesKey: meetingTimesKeyOf(single.meetingTimes),
    firstInterventionDiagnosesKey: diagnosesKeyOf(single.diagnoses)
  }, entityName);
  
  logScenario(entityName, scenarioName, single, logSpecIntervention);
}

settings {
  encodeUrl: true
  timeout: 0
}
