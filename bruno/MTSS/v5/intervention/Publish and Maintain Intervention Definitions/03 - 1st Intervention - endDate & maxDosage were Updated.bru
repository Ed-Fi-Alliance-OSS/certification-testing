meta {
  name: 03 - 1st Intervention - endDate & maxDosage were Updated
  type: http
  seq: 3
}

get {
  url: {{resourceBaseUrl}}/ed-fi/interventions/{{firstInterventionUniqueId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.id: isString
  res.body.id: isNotEmpty
  res.body.interventionIdentificationCode: isString
  res.body.interventionIdentificationCode: isNotEmpty
  res.body.educationOrganizationReference.educationOrganizationId: isNumber
  res.body.interventionClassDescriptor: isString
  res.body.interventionClassDescriptor: isNotEmpty
  res.body.deliveryMethodDescriptor: isString
  res.body.deliveryMethodDescriptor: isNotEmpty
  res.body.beginDate: isString
  res.body.beginDate: isNotEmpty
  res.body.namespace: isString
  res.body.namespace: isNotEmpty
  res.body.diagnoses: isArray
  res.body.diagnoses: isNotEmpty
  res.body.diagnoses[0].diagnosisDescriptor: isString
  res.body.diagnoses[0].diagnosisDescriptor: isNotEmpty
  res.body.endDate: isString
  res.body.endDate: isNotEmpty
  res.body.minDosage: isNumber
  res.body.minDosage: gt 0
  res.body.maxDosage: isNumber
  res.body.maxDosage: gt 0
  res.body.meetingTimes: isArray
  res.body.meetingTimes: isNotEmpty
  res.body.meetingTimes[0].startTime: isString
  res.body.meetingTimes[0].startTime: isNotEmpty
  res.body.meetingTimes[0].endTime: isString
  res.body.meetingTimes[0].endTime: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');

  validateDependency(bru, 'firstInterventionUniqueId', dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid'), {
    actionHint: 'Ensure you ran the first certification scenario successfully before continuing.'
  });
}

script:post-response {
  const { getVar, setVars, expectChanged, throwNotFoundOrSpecificError, meetingTimesKeyOf, diagnosesKeyOf } = require('./utils');
  const { logScenario, logSpecIntervention } = require('./logging');
  const entityName = 'Intervention';
  const scenarioName = this.req.name;

  if (res.status !== 200 || !res.body) {
    throwNotFoundOrSpecificError(entityName);
  }

  const current = res.getBody();

  expectChanged(getVar(bru, 'firstInterventionEndDate'), current.endDate, 'endDate');
  expectChanged(getVar(bru, 'firstInterventionMaxDosage'), current.maxDosage, 'maxDosage');

  setVars(bru, {
    firstInterventionEndDate: current.endDate,
    firstInterventionMaxDosage: current.maxDosage,
    firstInterventionMinDosage: current.minDosage,
    firstInterventionMeetingTimesKey: meetingTimesKeyOf(current.meetingTimes),
    firstInterventionDiagnosesKey: diagnosesKeyOf(current.diagnoses)
  }, entityName);

  logScenario(entityName, scenarioName, current, logSpecIntervention, [
    'endDate',
    'maxDosage'
  ]);
}

settings {
  encodeUrl: true
  timeout: 0
}
