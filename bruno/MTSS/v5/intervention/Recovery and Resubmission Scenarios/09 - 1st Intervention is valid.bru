meta {
  name: 09 - 1st Intervention is valid
  type: http
  seq: 9
}

get {
  url: {{resourceBaseUrl}}/ed-fi/interventions?educationOrganizationId={{firstInterventionEducationOrganizationId}}&interventionIdentificationCode={{firstInterventionIdentificationCode}}
  body: none
  auth: inherit
}

params:query {
  educationOrganizationId: {{firstInterventionEducationOrganizationId}}
  interventionIdentificationCode: {{firstInterventionIdentificationCode}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].interventionIdentificationCode: isString
  res.body[0].interventionIdentificationCode: isNotEmpty
  res.body[0].educationOrganizationReference: isDefined
  res.body[0].educationOrganizationReference.educationOrganizationId: isNumber
  res.body[0].educationOrganizationReference.educationOrganizationId: neq 0
  res.body[0].interventionClassDescriptor: isString
  res.body[0].interventionClassDescriptor: isNotEmpty
  res.body[0].deliveryMethodDescriptor: isString
  res.body[0].deliveryMethodDescriptor: isNotEmpty
  res.body[0].beginDate: isString
  res.body[0].beginDate: isNotEmpty
  res.body[0].namespace: isString
  res.body[0].namespace: isNotEmpty
  res.body[0].diagnoses: isArray
  res.body[0].diagnoses: isNotEmpty
  res.body[0].endDate: isString
  res.body[0].endDate: isNotEmpty
  res.body[0].minDosage: isNumber
  res.body[0].minDosage: gt 0
  res.body[0].maxDosage: isNumber
  res.body[0].maxDosage: gt 0
  res.body[0].meetingTimes: isArray
  res.body[0].meetingTimes: isNotEmpty
  res.body[0].meetingTimes[0].startTime: isString
  res.body[0].meetingTimes[0].startTime: isNotEmpty
  res.body[0].meetingTimes[0].endTime: isString
  res.body[0].meetingTimes[0].endTime: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const first = dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid');
  const updated = dependencyName('Publish and Maintain Intervention Definitions', '03 - 1st Intervention - endDate & maxDosage were Updated');

  validateDependency(bru, 'firstInterventionEducationOrganizationId', first);
  validateDependency(bru, 'firstInterventionIdentificationCode', first);
  validateDependency(bru, 'firstInterventionEndDate', updated);
  validateDependency(bru, 'firstInterventionMaxDosage', updated);
  validateDependency(bru, 'firstInterventionMinDosage', updated);
  validateDependency(bru, 'firstInterventionMeetingTimesKey', updated);
  validateDependency(bru, 'firstInterventionDiagnosesKey', updated);
}

script:post-response {
  const { pickSingle, getVar, setVars, wipeVars, expectUnchanged, meetingTimesKeyOf, diagnosesKeyOf } = require('./utils');
  const { logScenario, logSpecIntervention } = require('./logging');
  const entityName = 'Intervention';
  const scenarioName = this.req.name;
  const single = pickSingle(res.getBody());

  if (!single) {
    wipeVars(bru, ['restoredFirstInterventionUniqueId'], entityName, true);
  }

  // Restored with the latest values published (Publish step 03, or PATH 1 step 02), not older ones.
  expectUnchanged(getVar(bru, 'firstInterventionEndDate'), single.endDate, 'endDate restored with the latest value', true);
  expectUnchanged(Number(getVar(bru, 'firstInterventionMaxDosage')), single.maxDosage, 'maxDosage restored with the latest value', true);
  expectUnchanged(Number(getVar(bru, 'firstInterventionMinDosage')), single.minDosage, 'minDosage restored with the latest value', true);
  expectUnchanged(getVar(bru, 'firstInterventionMeetingTimesKey'), meetingTimesKeyOf(single.meetingTimes), 'meetingTimes restored with the latest values', true);
  expectUnchanged(getVar(bru, 'firstInterventionDiagnosesKey'), diagnosesKeyOf(single.diagnoses), 'diagnoses restored with the latest values', true);

  setVars(bru, {
    restoredFirstInterventionUniqueId: single.id
  }, entityName);

  logScenario(entityName, scenarioName, single, logSpecIntervention);
}

settings {
  encodeUrl: true
  timeout: 0
}
