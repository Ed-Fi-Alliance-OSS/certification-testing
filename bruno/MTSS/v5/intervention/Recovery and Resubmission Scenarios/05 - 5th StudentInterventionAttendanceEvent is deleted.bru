meta {
  name: 05 - 5th StudentInterventionAttendanceEvent is deleted
  type: http
  seq: 5
}

delete {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents/{{recoveryFifthStudentInterventionAttendanceEventUniqueId}}
  body: none
  auth: inherit
}

assert {
  res.status: in 204,404
}

script:pre-request {
  const { validateDependency, dependencyName, getVar, setVar, resolveCurrentId } = require('./utils');

  validateDependency(bru, 'firstStudentInterventionAssociationStudentUniqueId', dependencyName('Assign a Student to an Intervention', '01 - 1st StudentInterventionAssociation is valid'));
  validateDependency(bru, 'firstInterventionEducationOrganizationId', dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid'));
  validateDependency(bru, 'firstInterventionIdentificationCode', dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid'));
  validateDependency(bru, 'fifthStudentInterventionAttendanceEventEventDate', dependencyName('Record Intervention Participation Events', '07 - 5th StudentInterventionAttendanceEvent is valid'));
  validateDependency(bru, 'fifthStudentInterventionAttendanceEventCategory', dependencyName('Record Intervention Participation Events', '07 - 5th StudentInterventionAttendanceEvent is valid'));

  // Restored records get a new id, so resolve the current one by natural key.
  // When nothing is found (already deleted), the original id is used and the API answers 404.
  const currentId = await resolveCurrentId(bru, 'ed-fi/studentInterventionAttendanceEvents', {
    studentUniqueId: getVar(bru, 'firstStudentInterventionAssociationStudentUniqueId'),
    educationOrganizationId: getVar(bru, 'firstInterventionEducationOrganizationId'),
    interventionIdentificationCode: getVar(bru, 'firstInterventionIdentificationCode'),
    eventDate: getVar(bru, 'fifthStudentInterventionAttendanceEventEventDate'),
    attendanceEventCategoryDescriptor: getVar(bru, 'fifthStudentInterventionAttendanceEventCategory')
  }, getVar(bru, 'fifthStudentInterventionAttendanceEventUniqueId') || '00000000000000000000000000000000');

  setVar(bru, 'recoveryFifthStudentInterventionAttendanceEventUniqueId', currentId);
}

script:post-response {
  const { wipeVar } = require('./utils');

  if (res.status === 204) {
    console.log('5th attendance event was removed. It must come back after your normal synchronization.');
  } else if (res.status === 404) {
    console.log('5th attendance event was already removed (re-run of this scenario).');
  }

  wipeVar(bru, 'recoveryFifthStudentInterventionAttendanceEventUniqueId');
}

settings {
  encodeUrl: true
  timeout: 0
}
