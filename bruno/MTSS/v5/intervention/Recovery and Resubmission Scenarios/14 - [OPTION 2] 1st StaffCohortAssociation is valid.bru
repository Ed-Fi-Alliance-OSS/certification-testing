meta {
  name: 14 - [OPTION 2] 1st StaffCohortAssociation is valid
  type: http
  seq: 14
}

get {
  url: {{resourceBaseUrl}}/ed-fi/staffCohortAssociations?cohortIdentifier={{firstCohortIdentifier}}&educationOrganizationId={{firstCohortEducationOrganizationId}}
  body: none
  auth: inherit
}

params:query {
  cohortIdentifier: {{firstCohortIdentifier}}
  educationOrganizationId: {{firstCohortEducationOrganizationId}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].staffReference.staffUniqueId: isString
  res.body[0].staffReference.staffUniqueId: isNotEmpty
  res.body[0].beginDate: isString
  res.body[0].beginDate: isNotEmpty
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const scenario = 'Associate Staff with Intervention Delivery - [OPTION 2]';
  const intervention = dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid');

  validateDependency(bru, 'firstCohortIdentifier', dependencyName(scenario, '01 - 1st Cohort is valid'));
  validateDependency(bru, 'firstCohortEducationOrganizationId', dependencyName(scenario, '01 - 1st Cohort is valid'));
  validateDependency(bru, 'firstStaffCohortAssociationStaffUniqueId', dependencyName(scenario, '02 - 1st StaffCohortAssociation is valid'));
  validateDependency(bru, 'firstStaffCohortAssociationEndDate', dependencyName(scenario, '05 - 1st StaffCohortAssociation - endDate was Updated'));
  validateDependency(bru, 'firstStudentInterventionAssociationStudentUniqueId', dependencyName('Assign a Student to an Intervention', '01 - 1st StudentInterventionAssociation is valid'));
  validateDependency(bru, 'firstInterventionEducationOrganizationId', intervention);
  validateDependency(bru, 'firstInterventionIdentificationCode', intervention);
}

script:post-response {
  const { pickSingle, getVar, setVars, wipeVars, expectUnchanged, fetchRecords } = require('./utils');
  const { logScenario, logSpecStaffCohortAssociation } = require('./logging');
  const entityName = 'StaffCohortAssociation';
  const scenarioName = this.req.name;
  const body = res.getBody();

  // Only the 1st staff member: the 2nd association was deleted by the provider earlier.
  test('the Cohort has exactly one StaffCohortAssociation, for the 1st staff member', () => {
    expect(body).to.be.an('array').with.lengthOf(1);
    expect(body[0].staffReference.staffUniqueId).to.equal(getVar(bru, 'firstStaffCohortAssociationStaffUniqueId'));
  });

  const single = pickSingle(body);

  if (!single) {
    wipeVars(bru, ['restoredFirstStaffCohortAssociationUniqueId'], entityName, true);
  }

  expectUnchanged(getVar(bru, 'firstStaffCohortAssociationEndDate'), single.endDate, 'endDate restored with the latest value', true);

  // The restored student assignment must still reference the Cohort (the OPTION 2 staff link).
  const sia = await fetchRecords(bru, 'ed-fi/studentInterventionAssociations', {
    studentUniqueId: getVar(bru, 'firstStudentInterventionAssociationStudentUniqueId'),
    educationOrganizationId: getVar(bru, 'firstInterventionEducationOrganizationId'),
    interventionIdentificationCode: getVar(bru, 'firstInterventionIdentificationCode')
  });

  test('restored 1st StudentInterventionAssociation references the 1st Cohort', () => {
    expect(sia, 'lookup of the 1st association failed').to.be.an('array').with.lengthOf(1);
    expect(sia[0].cohortReference && sia[0].cohortReference.cohortIdentifier).to.equal(getVar(bru, 'firstCohortIdentifier'));
  });

  setVars(bru, {
    restoredFirstStaffCohortAssociationUniqueId: single.id
  }, entityName);

  logScenario(entityName, scenarioName, single, logSpecStaffCohortAssociation);
}

settings {
  encodeUrl: true
  timeout: 0
}
