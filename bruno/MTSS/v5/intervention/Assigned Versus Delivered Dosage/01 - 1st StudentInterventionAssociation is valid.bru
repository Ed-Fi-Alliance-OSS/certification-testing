meta {
  name: 01 - 1st StudentInterventionAssociation is valid
  type: http
  seq: 1
}

get {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations?studentUniqueId={{firstStudentInterventionAssociationStudentUniqueId}}&educationOrganizationId={{firstInterventionEducationOrganizationId}}&interventionIdentificationCode={{firstInterventionIdentificationCode}}
  body: none
  auth: inherit
}

params:query {
  studentUniqueId: {{firstStudentInterventionAssociationStudentUniqueId}}
  educationOrganizationId: {{firstInterventionEducationOrganizationId}}
  interventionIdentificationCode: {{firstInterventionIdentificationCode}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body: isNotEmpty
  res.body[0].id: isString
  res.body[0].id: isNotEmpty
  res.body[0].studentReference.studentUniqueId: isString
  res.body[0].studentReference.studentUniqueId: isNotEmpty
  res.body[0].interventionReference.educationOrganizationId: isNumber
  res.body[0].interventionReference.educationOrganizationId: neq 0
  res.body[0].interventionReference.interventionIdentificationCode: isString
  res.body[0].interventionReference.interventionIdentificationCode: isNotEmpty
  res.body[0].dosage: isNumber
  res.body[0].dosage: gt 0
}

script:pre-request {
  const { validateDependency, dependencyName } = require('./utils');
  const intervention = dependencyName('Publish and Maintain Intervention Definitions', '01 - 1st Intervention is valid');

  validateDependency(bru, 'firstInterventionEducationOrganizationId', intervention);
  validateDependency(bru, 'firstInterventionIdentificationCode', intervention);
  validateDependency(bru, 'firstStudentInterventionAssociationStudentUniqueId', dependencyName('Assign a Student to an Intervention', '01 - 1st StudentInterventionAssociation is valid'));
}

script:post-response {
  const { pickSingle, setVars, wipeVars } = require('./utils');
  const { logScenario, logSpecStudentInterventionAssociation } = require('./logging');
  const entityName = 'StudentInterventionAssociation';
  const scenarioName = this.req.name;
  const single = pickSingle(res.getBody());

  if (!single) {
    wipeVars(bru, ['dosageAssignedMinutes'], entityName, true);
  }

  setVars(bru, {
    dosageAssignedMinutes: single.dosage
  }, entityName);

  logScenario(entityName, scenarioName, single, logSpecStudentInterventionAssociation, [
    'studentUniqueId',
    'interventionIdentificationCode',
    'dosage'
  ]);
}

settings {
  encodeUrl: true
  timeout: 0
}
