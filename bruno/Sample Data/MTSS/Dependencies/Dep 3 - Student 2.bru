meta {
  name: Dep 3 - Student 2
  type: http
  seq: 4
}

post {
  url: {{resourceBaseUrl}}/ed-fi/students
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "studentUniqueId": "99999912",
    "firstName": "Ben",
    "lastSurname": "Foundation",
    "birthDate": "2017-03-14",
    "birthCity": "Foundation City",
    "birthCountryDescriptor": "uri://ed-fi.org/CountryDescriptor#US"
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFoundationSecondStudentUUID', locationHeader.split('/').pop());
    console.log('Student data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
