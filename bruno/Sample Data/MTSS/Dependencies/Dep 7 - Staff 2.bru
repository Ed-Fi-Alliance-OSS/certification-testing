meta {
  name: Dep 7 - Staff 2
  type: http
  seq: 8
}

post {
  url: {{resourceBaseUrl}}/ed-fi/staffs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "staffUniqueId": "mtss-staff-02",
    "firstName": "Dan",
    "lastSurname": "Interventionist",
    "birthDate": "1985-06-01",
    "sexDescriptor": "uri://ed-fi.org/SexDescriptor#Female",
    "highestCompletedLevelOfEducationDescriptor": "uri://ed-fi.org/LevelOfEducationDescriptor#Master's",
    "hispanicLatinoEthnicity": false
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFoundationSecondStaffUUID', locationHeader.split('/').pop());
    console.log('Staff data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
