meta {
  name: Dep 5 - StudentSchoolAssociation 2
  type: http
  seq: 6
}

post {
  url: {{resourceBaseUrl}}/ed-fi/studentSchoolAssociations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "schoolReference": {
      "schoolId": 9999999911
    },
    "studentReference": {
      "studentUniqueId": "99999912"
    },
    "entryDate": "2026-08-17",
    "entryGradeLevelDescriptor": "uri://ed-fi.org/GradeLevelDescriptor#Third grade",
    "entryTypeDescriptor": "uri://ed-fi.org/EntryTypeDescriptor#Next year school",
    "primarySchool": true
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFoundationSecondStudentSchoolAssociationUUID', locationHeader.split('/').pop());
    console.log('StudentSchoolAssociation data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
