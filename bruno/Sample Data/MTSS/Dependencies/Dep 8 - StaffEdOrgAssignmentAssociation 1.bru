meta {
  name: Dep 8 - StaffEdOrgAssignmentAssociation 1
  type: http
  seq: 9
}

post {
  url: {{resourceBaseUrl}}/ed-fi/staffEducationOrganizationAssignmentAssociations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "staffReference": {
      "staffUniqueId": "mtss-staff-01"
    },
    "educationOrganizationReference": {
      "educationOrganizationId": 9999999911
    },
    "beginDate": "2026-08-01",
    "staffClassificationDescriptor": "uri://ed-fi.org/StaffClassificationDescriptor#Teacher",
    "positionTitle": "Interventionist"
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFoundationFirstStaffEdOrgAssignmentUUID', locationHeader.split('/').pop());
    console.log('StaffEducationOrganizationAssignmentAssociation data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
