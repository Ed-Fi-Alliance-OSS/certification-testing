meta {
  name: Step 2 - Intervention 2 ATTD-T2-001
  type: http
  seq: 3
}

post {
  url: {{resourceBaseUrl}}/ed-fi/interventions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "interventionIdentificationCode": "ATTD-T2-001",
    "educationOrganizationReference": {
      "educationOrganizationId": 9999999911
    },
    "interventionClassDescriptor": "uri://ed-fi.org/InterventionClassDescriptor#Supplement",
    "deliveryMethodDescriptor": "uri://ed-fi.org/DeliveryMethodDescriptor#Individual",
    "beginDate": "2026-08-24",
    "namespace": "{{providerNamespace}}",
    "diagnoses": [
      {
        "diagnosisDescriptor": "uri://ed-fi.org/DiagnosisDescriptor#Low Attendance"
      }
    ]
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempSecondInterventionUUID', locationHeader.split('/').pop());
    console.log('Intervention data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
