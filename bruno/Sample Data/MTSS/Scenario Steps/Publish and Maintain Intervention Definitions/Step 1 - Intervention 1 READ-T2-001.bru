meta {
  name: Step 1 - Intervention 1 READ-T2-001
  type: http
  seq: 2
}

post {
  url: {{resourceBaseUrl}}/ed-fi/interventions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "interventionIdentificationCode": "READ-T2-001",
    "educationOrganizationReference": {
      "educationOrganizationId": 9999999911
    },
    "interventionClassDescriptor": "uri://ed-fi.org/InterventionClassDescriptor#Practice",
    "deliveryMethodDescriptor": "uri://ed-fi.org/DeliveryMethodDescriptor#Small Group",
    "beginDate": "2026-08-24",
    "minDosage": 300,
    "maxDosage": 1200,
    "namespace": "{{providerNamespace}}",
    "diagnoses": [
      {
        "diagnosisDescriptor": "{{providerNamespace}}/DiagnosisDescriptor#Reading Fluency"
      }
    ],
    "staffs": [
      {
        "staffReference": {
          "staffUniqueId": "mtss-staff-01"
        }
      }
    ],
    "meetingTimes": [
      {
        "startTime": "09:00:00",
        "endTime": "09:30:00"
      }
    ]
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFirstInterventionUUID', locationHeader.split('/').pop());
    console.log('Intervention data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
