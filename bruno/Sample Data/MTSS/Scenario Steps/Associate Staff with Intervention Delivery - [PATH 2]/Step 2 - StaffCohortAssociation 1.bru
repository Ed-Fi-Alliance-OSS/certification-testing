meta {
  name: Step 2 - StaffCohortAssociation 1
  type: http
  seq: 2
}

post {
  url: {{resourceBaseUrl}}/ed-fi/staffCohortAssociations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "staffReference": {
      "staffUniqueId": "mtss-staff-01"
    },
    "cohortReference": {
      "cohortIdentifier": "READ-T2-001-GRP-A",
      "educationOrganizationId": 9999999911
    },
    "beginDate": "2026-08-24",
    "studentRecordAccess": true
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFirstStaffCohortAssociationUUID', locationHeader.split('/').pop());
    console.log('StaffCohortAssociation data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
