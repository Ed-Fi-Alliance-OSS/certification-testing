meta {
  name: Step 4 - Event 4
  type: http
  seq: 5
}

post {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "studentReference": {
      "studentUniqueId": "99999911"
    },
    "interventionReference": {
      "educationOrganizationId": 9999999911,
      "interventionIdentificationCode": "READ-T2-001"
    },
    "eventDate": "2026-09-11",
    "attendanceEventCategoryDescriptor": "uri://ed-fi.org/AttendanceEventCategoryDescriptor#Unexcused Absence",
    "interventionDuration": 0
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFourthStudentInterventionAttendanceEventUUID', locationHeader.split('/').pop());
    console.log('StudentInterventionAttendanceEvent data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
