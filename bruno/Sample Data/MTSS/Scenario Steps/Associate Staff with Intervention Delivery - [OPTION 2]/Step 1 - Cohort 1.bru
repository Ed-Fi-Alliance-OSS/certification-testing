meta {
  name: Step 1 - Cohort 1
  type: http
  seq: 1
}

post {
  url: {{resourceBaseUrl}}/ed-fi/cohorts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "cohortIdentifier": "READ-T2-001-GRP-A",
    "educationOrganizationReference": {
      "educationOrganizationId": 9999999911
    },
    "cohortTypeDescriptor": "uri://ed-fi.org/CohortTypeDescriptor#Academic Intervention",
    "cohortScopeDescriptor": "uri://ed-fi.org/CohortScopeDescriptor#School",
    "academicSubjectDescriptor": "uri://ed-fi.org/AcademicSubjectDescriptor#Reading",
    "cohortDescription": "READ-T2-001 small group A"
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFirstCohortUUID', locationHeader.split('/').pop());
    console.log('Cohort data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
