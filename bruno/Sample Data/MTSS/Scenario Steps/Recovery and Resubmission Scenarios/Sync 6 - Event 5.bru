meta {
  name: Sync 6 - Event 5
  type: http
  seq: 8
}

post {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "studentReference": {
      "studentUniqueId": "99999911"
    },
    "interventionReference": {
      "educationOrganizationId": 9999999911,
      "interventionIdentificationCode": "READ-T2-001"
    },
    "eventDate": "2026-09-11",
    "attendanceEventCategoryDescriptor": "uri://ed-fi.org/AttendanceEventCategoryDescriptor#Excused Absence",
    "interventionDuration": 0,
    "attendanceEventReason": "Family emergency"
  }
}

assert {
  res.status: in 200,201
}

settings {
  encodeUrl: true
  timeout: 0
}
