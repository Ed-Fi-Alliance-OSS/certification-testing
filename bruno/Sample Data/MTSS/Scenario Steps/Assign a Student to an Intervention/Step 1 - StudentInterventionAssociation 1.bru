meta {
  name: Step 1 - StudentInterventionAssociation 1
  type: http
  seq: 1
}

post {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "studentReference": {
      "studentUniqueId": "99999911"
    },
    "interventionReference": {
      "educationOrganizationId": 9999999911,
      "interventionIdentificationCode": "READ-T2-001"
    },
    "dosage": 600,
    "diagnosticStatement": "Student demonstrates reading fluency needs."
  }
}

assert {
  res.status: in 200,201
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempFirstStudentInterventionAssociationUUID', locationHeader.split('/').pop());
    console.log('StudentInterventionAssociation data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
