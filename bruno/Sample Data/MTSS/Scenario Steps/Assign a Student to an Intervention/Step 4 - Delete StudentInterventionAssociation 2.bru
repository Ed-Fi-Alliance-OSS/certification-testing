meta {
  name: Step 4 - Delete StudentInterventionAssociation 2
  type: http
  seq: 4
}

delete {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations/{{tempSecondStudentInterventionAssociationUUID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

assert {
  res.status: eq 204
}

script:pre-request {
  const { validateDependency } = require('./utils');

  validateDependency(bru, 'tempSecondStudentInterventionAssociationUUID', 'Step 2 - StudentInterventionAssociation 2', {
    actionHint: 'Run the create script first so its id is cached.'
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
