meta {
  name: Down 3 - Event 3
  type: http
  seq: 3
}

delete {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAttendanceEvents/{{tempResetUUID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

assert {
  res.status: in 204,404
}

script:pre-request {
  const { setVar, resolveCurrentId } = require('./utils');

  // Natural-key lookup; when the record doesn't exist, target a missing id so the API answers 404.
  setVar(bru, 'tempResetUUID', await resolveCurrentId(bru, 'ed-fi/studentInterventionAttendanceEvents', {"studentUniqueId":"99999911","educationOrganizationId":9999999911,"interventionIdentificationCode":"READ-T2-001","eventDate":"2026-09-10", "attendanceEventCategoryDescriptor": "uri://ed-fi.org/AttendanceEventCategoryDescriptor#Partial"}, '00000000000000000000000000000000'));
}

script:post-response {
  console.log(res.status === 204 ? 'Event 3 was deleted.' : 'Event 3 was not present.');
}

settings {
  encodeUrl: true
  timeout: 0
}
