meta {
  name: Down 12 - Intervention 1 READ-T2-001
  type: http
  seq: 12
}

delete {
  url: {{resourceBaseUrl}}/ed-fi/interventions/{{tempResetUUID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

assert {
  res.status: in 204,404
}

script:pre-request {
  const { setVar, resolveCurrentId } = require('./utils');

  // Natural-key lookup; when the record doesn't exist, target a missing id so the API answers 404.
  setVar(bru, 'tempResetUUID', await resolveCurrentId(bru, 'ed-fi/interventions', {"educationOrganizationId":9999999911,"interventionIdentificationCode":"READ-T2-001"}, '00000000000000000000000000000000'));
}

script:post-response {
  console.log(res.status === 204 ? 'Intervention 1 READ-T2-001 was deleted.' : 'Intervention 1 READ-T2-001 was not present.');
}

settings {
  encodeUrl: true
  timeout: 0
}
