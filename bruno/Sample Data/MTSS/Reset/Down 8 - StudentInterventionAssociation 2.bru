meta {
  name: Down 8 - StudentInterventionAssociation 2
  type: http
  seq: 8
}

delete {
  url: {{resourceBaseUrl}}/ed-fi/studentInterventionAssociations/{{tempResetUUID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

assert {
  res.status: in 204,404
}

script:pre-request {
  const { setVar, resolveCurrentId } = require('./utils');

  // Natural-key lookup; when the record doesn't exist, target a missing id so the API answers 404.
  setVar(bru, 'tempResetUUID', await resolveCurrentId(bru, 'ed-fi/studentInterventionAssociations', {"studentUniqueId":"99999912","educationOrganizationId":9999999911,"interventionIdentificationCode":"READ-T2-001"}, '00000000000000000000000000000000'));
}

script:post-response {
  console.log(res.status === 204 ? 'StudentInterventionAssociation 2 was deleted.' : 'StudentInterventionAssociation 2 was not present.');
}

settings {
  encodeUrl: true
  timeout: 0
}
