meta {
  name: Aux 2 - Interventions
  type: http
  seq: 2
}

post {
  url: {{resourceBaseUrl}}/ed-fi/interventions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "interventionIdentificationCode": "[ENTER_INTERVENTION_IDENTIFICATION_CODE]",
    "educationOrganizationReference": { "educationOrganizationId": [ENTER_EDUCATION_ORGANIZATION_ID] },
    "interventionClassDescriptor": "uri://ed-fi.org/InterventionClassDescriptor#Practice",
    "deliveryMethodDescriptor": "uri://ed-fi.org/DeliveryMethodDescriptor#Small Group",
    "beginDate": "[ENTER_BEGIN_DATE]",
    "namespace": "{{providerNamespace}}",
    "diagnoses": [ { "diagnosisDescriptor": "[ENTER_DIAGNOSIS_DESCRIPTOR]" } ],
    "staffs": [ { "staffReference": { "staffUniqueId": "[ENTER_STAFF_UNIQUE_ID]" } } ]
  }
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempInterventionUUID', locationHeader.split('/').pop());
    console.log('Intervention data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
