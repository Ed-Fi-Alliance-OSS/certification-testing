meta {
  name: Aux 2 - Cohorts
  type: http
  seq: 2
}

post {
  url: {{resourceBaseUrl}}/ed-fi/cohorts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "cohortIdentifier": "[ENTER_COHORT_IDENTIFIER]",
    "educationOrganizationReference": { "educationOrganizationId": [ENTER_EDUCATION_ORGANIZATION_ID] },
    "cohortTypeDescriptor": "uri://ed-fi.org/CohortTypeDescriptor#Academic Intervention",
    "cohortScopeDescriptor": "uri://ed-fi.org/CohortScopeDescriptor#District",
    "cohortDescription": "[ENTER_COHORT_DESCRIPTION]"
  }
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempCohortUUID', locationHeader.split('/').pop());
    console.log('Cohort data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
