meta {
  name: Aux 2 - StaffCohortAssociations
  type: http
  seq: 2
}

post {
  url: {{resourceBaseUrl}}/ed-fi/staffCohortAssociations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{edFiCertToken}}
}

body:json {
  {
    "staffReference": { "staffUniqueId": "[ENTER_STAFF_UNIQUE_ID]" },
    "cohortReference": { "cohortIdentifier": "[ENTER_COHORT_IDENTIFIER]", "educationOrganizationId": [ENTER_EDUCATION_ORGANIZATION_ID] },
    "beginDate": "[ENTER_BEGIN_DATE]",
    "studentRecordAccess": true
  }
}

script:post-response {
  const locationHeader = res.headers.Location || res.headers.location;
  if (locationHeader) {
    bru.setVar('tempStaffCohortAssociationUUID', locationHeader.split('/').pop());
    console.log('StaffCohortAssociation data was created correctly.');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
